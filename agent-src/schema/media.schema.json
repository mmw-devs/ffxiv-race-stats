{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.schema.json",
  "title": "Media",
  "description": "首页媒体资源（站内路径或 CDN URL）",
  "type": "object",
  "required": ["heroVideo", "heroPoster"],
  "properties": {
    "heroVideo": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(/|https?://)",
      "description": "首页大屏视频"
    },
    "heroPoster": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(/|https?://)",
      "description": "视频加载失败 / 首帧海报"
    }
  },
  "additionalProperties": false
}
