# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code — 本地开发指引，不提交远程
# ⚠ 受 .githooks/ 保护：误删后自动从 .git/safe/ 恢复
.claude/

# Backup files
*.bak

# Dependencies
node_modules/

# Static server logs (if any)
access.log
error.log

# PI Agent — 本地凭证（飞书 App Secret 等），不提交
# 仅忽略敏感配置；其余 .pi/ 内容（SYSTEM.md/extensions/prompts/rules/skills）为团队共享配置，仍纳入版本控制
.pi/settings.json

# Agent 会话日志（本地，不入仓）
.pi/sessions/

# PI Agent 运行时临时文件（local-only，每次运行会重新生成）
.pi/runtime/

# Subagent 运行产物（local-only）
.pi-subagents/

# PI Agent / skills 本地状态与锁文件
.agents/
agent/
skills-lock.json

# archify 技能输出（临时架构图等）
docs/archify/

# PI Agent settings.json 备份与中间文件
.pi/settings.json.*

# macOS / 第三方工具偶发写入项目根的垃圾目录
undefined:/

# 临时登录 QR（不入仓）
/auth-qr.png

# 异常空目录（本地调试产物，不入仓）
/package/

# agent-src/ 内嵌的 git 仓库元数据（不影响 ops 同步，sync workflow 通过 rsync 排除）
/agent-src/.git/

# Windows/WSL 元数据
*:Zone.Identifier

# Lighthouse CI 输出目录（lhci autorun / collect 产物）
.lighthouseci/

# Chromium user-data-dir 误写入根目录（Windows/WSL 下 lhci 启 Chrome 时未指定 --userDataDir，
# 会把整段 WSL 路径当字面目录名创建出来，PID 段范围 [0-9]+）
*lighthouse.[0-9]*/

dist/
.astro/
# LHCI 临时 Chrome 用户数据目录（WSL 路径污染）
\\wsl.localhost/**
