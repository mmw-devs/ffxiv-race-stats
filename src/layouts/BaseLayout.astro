---
// BaseLayout.astro — 全局布局
// 承载 HTML head、页面骨架与全局样式入口；token / 组件样式在 src/styles/*.css。
// 所有 Vue 组件输出 .az-* 标记，保证单一设计源。
// 首页大屏：底部宽幅视频带（浏览器本地播放）+ 标题浮层。
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import type { Seo } from '../../types/race-data'
import '../styles/global.css'

// 构建期 SEO：有 .astro-data/data.json 时用 data.json 的 content.seo，
// 否则回退通用文案（普通 npm run build / build-verify 不强制出网）。
const FALLBACK_SEO: Seo = {
  title: 'FFXIV 高难首杀竞速',
  description: 'FFXIV 高难首杀竞速排行聚合平台，追踪高难副本的世界首杀争夺战，提供队伍进度、选手直播、赛事速报一站式浏览。',
}

let seo: Seo = FALLBACK_SEO
try {
  const buildData = JSON.parse(
    readFileSync(join(process.cwd(), '.astro-data', 'data.json'), 'utf8')
  ) as { content?: { seo?: Partial<Seo> } }
  const candidate = buildData.content?.seo
  if (candidate && typeof candidate.title === 'string' && typeof candidate.description === 'string') {
    seo = { ...FALLBACK_SEO, ...candidate }
  }
} catch {
  // 构建期没有数据：保持静态 fallback，客户端 usePageSeo 仍会更新
}
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="theme-color" content="#15171d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />
  <script>
    document.documentElement.classList.add('js');
    (function () {
      var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
      if (rm && rm.matches) { document.documentElement.classList.add('loaded'); return; }

      var done = false;
      function reveal() {
        if (done) return;
        done = true;
        document.documentElement.classList.add('loaded');
      }
      // 双 rAF：保证先渲染一帧隐藏态，入场动画才会真正播放
      function arm() {
        if ('requestAnimationFrame' in window) {
          requestAnimationFrame(function () { requestAnimationFrame(reveal); });
        } else { reveal(); }
      }
      // hero 一渲染出来就立即入场，不再等固定延时（原先的 760ms 黑屏）
      function watch() {
        if (document.querySelector('.az-hero')) { arm(); return; }
        var obs = new MutationObserver(function () {
          if (document.querySelector('.az-hero')) { obs.disconnect(); arm(); }
        });
        obs.observe(document.documentElement, { childList: true, subtree: true });
      }
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', watch); }
      else { watch(); }

      // 兜底：异常情况下最迟 600ms 也要把内容放出来，绝不卡在黑屏
      setTimeout(reveal, 600);
    })();
  </script>
</head>
<body>
  <noscript>
    <div class="az-noscript">本站需要启用 JavaScript 才能加载实时竞速数据，请开启后刷新。</div>
  </noscript>
  <div class="az-progress" id="scrollProgress" aria-hidden="true"></div>

  <slot />

  <script>
    // inspect 模式 — localhost:4321 专属，?inspect 或 localStorage 任一命中即注入
    // 生产环境端口为 80/443，条件自然失效，无需分支判断
    // 开关: /inspect-on.html 和 /inspect-off.html 设置/清除 localStorage
    if (location.port === '4321' && (location.search.includes('inspect') || localStorage.getItem('pi_inspect') === '1')) {
      const s = document.createElement('script');
      s.src = '/scripts/inspect.js';
      document.body.appendChild(s);
    }
  </script>
</body>
</html>
