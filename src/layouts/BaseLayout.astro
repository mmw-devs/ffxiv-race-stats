---
// BaseLayout.astro — 全局布局，承载 OKLCH token 系统和外部脚本
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FFXIV 高难首杀竞速 — [当届赛事名称]</title>
  <meta name="description" content="FFXIV 高难首杀竞速排行聚合平台，追踪高难副本的世界首杀争夺战，提供队伍进度、选手直播、赛事速报一站式浏览。" />
  <meta name="theme-color" content="#f5f4ef" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="FFXIV 高难首杀竞速" />
  <meta property="og:description" content="追踪高难副本世界首杀争夺战，队伍进度、选手直播、赛事速报一站式浏览。" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />
  <style is:inline>
    /* ---- RESET & BASE ---- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      font-size: 16px;
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    body { max-width: 1280px; margin: 0 auto; padding: 0 24px 80px; min-height: 100vh; }

    /* ---- TYPOGRAPHY ---- */
    h1, h2, h3 { font-family: var(--font-display); font-weight: 700; }
    h1 { font-size: clamp(48px, 6vw, 96px); line-height: 1.05; letter-spacing: -0.025em; }
    h2 { font-size: 28px; line-height: 1.15; letter-spacing: -0.015em; }
    h3 { font-size: 20px; line-height: 1.2; }
    p  { max-width: 65ch; }
    a  { color: var(--fg); text-underline-offset: 4px; }
    a:hover { color: var(--accent); }

    /* ---- REDUCED MOTION ---- */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ---- TOKEN SYSTEM ---- */
    /* ===========================================================
       TOKEN SYSTEM — 换 6~10 个变量即可切换整站主题风格
       =========================================================== */
    :root {
      --bg:      oklch(98% 0.004 90);
      --surface: oklch(100% 0 0);
      --fg:      oklch(15% 0.02 100);
      --muted:   oklch(42% 0.02 100);
      --border:  oklch(15% 0.02 100);
      --accent:  oklch(55% 0.18 50);

      --crt-bg:    oklch(18% 0.016 148);
      --crt-fg:    oklch(80% 0.06 148);
      --crt-glow:  oklch(74% 0.10 145);
      --crt-muted: oklch(50% 0.03 148);
      --crt-border:oklch(28% 0.015 148);

      --live:   oklch(55% 0.20 28);
      --warn:   oklch(48% 0.16 60);
      --success:oklch(40% 0.16 155);

      --font-display: 'Times New Roman', 'Iowan Old Style', Georgia, serif;
      --font-body:    ui-monospace, 'IBM Plex Mono', 'JetBrains Mono', Menlo, monospace;
      --font-mono:    'JetBrains Mono', 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    }
  </style>
</head>
<body>
  <slot />
  <script>
    // inspect 模式 — localhost:4321 专属，?inspect 或 localStorage 任一命中即注入
    // 生产环境端口为 80/443，条件自然失效，无需分支判断
    // 开关: /inspect-on.html 和 /inspect-off.html 设置/清除 localStorage
    if (location.port === '4321' && (location.search.includes('inspect') || localStorage.getItem('pi_inspect') === '1')) {
      const s = document.createElement('script');
      s.src = '/scripts/inspect.js';
      document.body.appendChild(s);
    }
  </script>
</body>
</html>
