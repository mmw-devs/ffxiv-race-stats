---
// BaseLayout.astro — 全局布局
// 承载 HTML head、页面骨架与全局样式入口；token / 组件样式在 src/styles/*.css。
// 所有 Vue 组件输出 .az-* 标记，保证单一设计源。
// 首页大屏：底部宽幅视频带（浏览器本地播放）+ 标题浮层。
import { createHash } from 'node:crypto'
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import type { Seo } from '../../types/race-data'
import { DATA_BUILD_DATA_PATH, DATA_BUILD_META_PATH } from '../../shared/data-path.mjs'
import '../styles/global.css'

// 方案 A：head 是构建时快照。
// - 没有 .astro-data：普通 build / build-verify，使用通用 fallback；
// - 有快照：必须带 meta.json 且 sha256 匹配，坏快照直接让构建失败，不再静默降级。
const FALLBACK_SEO: Seo = {
  title: 'FFXIV 高难首杀竞速 · 赛事档案',
  description: 'FFXIV 高难首杀竞速赛事档案与排行聚合。',
}

function loadBuildSeo(): Seo {
  const dataPath = join(process.cwd(), DATA_BUILD_DATA_PATH)
  if (!existsSync(dataPath)) return FALLBACK_SEO

  const metaPath = join(process.cwd(), DATA_BUILD_META_PATH)
  if (!existsSync(metaPath)) throw new Error(`缺少 ${DATA_BUILD_META_PATH}`)

  const raw = readFileSync(dataPath, 'utf8')
  const meta = JSON.parse(readFileSync(metaPath, 'utf8')) as { sha256?: unknown }
  const sha256 = createHash('sha256').update(raw).digest('hex')
  if (typeof meta.sha256 !== 'string' || meta.sha256 !== sha256) {
    throw new Error('构建数据快照哈希不匹配')
  }

  const buildData = JSON.parse(raw) as { content?: { seo?: Partial<Seo> } }
  const candidate = buildData.content?.seo
  if (
    !candidate ||
    typeof candidate.title !== 'string' ||
    typeof candidate.description !== 'string' ||
    (candidate.ogImage !== undefined && typeof candidate.ogImage !== 'string')
  ) {
    throw new Error('快照缺少合法的 content.seo')
  }
  return { ...FALLBACK_SEO, ...candidate }
}

const seo: Seo = loadBuildSeo()
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="theme-color" content="#15171d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />
  <script>
    document.documentElement.classList.add('js');
    (function () {
      var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
      if (rm && rm.matches) { document.documentElement.classList.add('loaded'); return; }

      var done = false;
      function reveal() {
        if (done) return;
        done = true;
        document.documentElement.classList.add('loaded');
      }
      // 双 rAF：保证先渲染一帧隐藏态，入场动画才会真正播放
      function arm() {
        if ('requestAnimationFrame' in window) {
          requestAnimationFrame(function () { requestAnimationFrame(reveal); });
        } else { reveal(); }
      }
      // hero 一渲染出来就立即入场，不再等固定延时（原先的 760ms 黑屏）
      function watch() {
        if (document.querySelector('.az-hero')) { arm(); return; }
        var obs = new MutationObserver(function () {
          if (document.querySelector('.az-hero')) { obs.disconnect(); arm(); }
        });
        obs.observe(document.documentElement, { childList: true, subtree: true });
      }
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', watch); }
      else { watch(); }

      // 兜底：异常情况下最迟 600ms 也要把内容放出来，绝不卡在黑屏
      setTimeout(reveal, 600);
    })();
  </script>
</head>
<body>
  <noscript>
    <div class="az-noscript">本站需要启用 JavaScript 才能加载实时竞速数据，请开启后刷新。</div>
  </noscript>
  <div class="az-progress" id="scrollProgress" aria-hidden="true"></div>

  <slot />

  <script>
    // inspect 模式 — localhost:4321 专属，?inspect 或 localStorage 任一命中即注入
    // 生产环境端口为 80/443，条件自然失效，无需分支判断
    // 开关: /inspect-on.html 和 /inspect-off.html 设置/清除 localStorage
    if (location.port === '4321' && (location.search.includes('inspect') || localStorage.getItem('pi_inspect') === '1')) {
      const s = document.createElement('script');
      s.src = '/scripts/inspect.js';
      document.body.appendChild(s);
    }
  </script>
</body>
</html>
